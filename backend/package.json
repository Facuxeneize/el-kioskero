    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcrypt": "6.0.0",
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "dotenv": "^16.6.1",
    "express": "5.2.1",
    "express-rate-limit": "^8.6.2",
    "helmet": "8.1.0",
    "jsonwebtoken": "9.0.3",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/bcrypt": "6.0.0",
    "@types/cookie-parser": "1.4.10",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "24.13.3",
    "oxlint": "1.75.0",
    "prisma": "^6.19.3",
    "tsx": "4.21.0",
    "typescript": "6.0.2",
    "vitest": "4.1.0"
