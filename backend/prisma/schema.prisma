generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
}

enum SaleStatus {
  COMPLETED
  VOIDED
}

enum StockMovementType {
  IN
  SALE
  ADJUSTMENT
  SALE_VOID
}

enum StockReferenceType {
  SALE
  MANUAL
}

model User {
  id            String          @id @default(uuid()) @db.Char(36)
  name          String          @db.VarChar(120)
  email         String          @unique @db.VarChar(190)
  passwordHash  String          @map("password_hash") @db.VarChar(255)
  role          UserRole        @default(ADMIN)
  isActive      Boolean         @default(true) @map("is_active")
  lastLoginAt   DateTime?       @map("last_login_at") @db.DateTime(3)
  createdAt     DateTime        @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt     DateTime        @updatedAt @map("updated_at") @db.DateTime(3)
  refreshTokens RefreshToken[]
  sales         Sale[]
  stockMovements StockMovement[]

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Char(36)
  userId    String    @map("user_id") @db.Char(36)
  tokenHash String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt DateTime  @map("expires_at") @db.DateTime(3)
  revokedAt DateTime? @map("revoked_at") @db.DateTime(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model Product {
  id             String          @id @default(uuid()) @db.Char(36)
  barcode        String          @unique @db.VarChar(64)
  name           String          @db.VarChar(160)
  description    String?         @db.VarChar(500)
  salePrice      Decimal         @map("sale_price") @db.Decimal(12, 2)
  currentStock   Int             @default(0) @map("current_stock")
  minimumStock   Int             @default(0) @map("minimum_stock")
  isActive       Boolean         @default(true) @map("is_active")
  createdAt      DateTime        @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.DateTime(3)
  saleItems      SaleItem[]
  stockMovements StockMovement[]

  @@index([name])
  @@index([isActive])
  @@map("products")
}

model Sale {
  id             String       @id @default(uuid()) @db.Char(36)
  saleNumber     BigInt       @unique @default(autoincrement()) @map("sale_number")
  idempotencyKey String?      @unique @map("idempotency_key") @db.VarChar(100)
  total          Decimal      @db.Decimal(12, 2)
  totalUnits     Int          @map("total_units")
  status         SaleStatus   @default(COMPLETED)
  createdById    String       @map("created_by") @db.Char(36)
  createdAt      DateTime     @default(now()) @map("created_at") @db.DateTime(3)
  voidedAt       DateTime?    @map("voided_at") @db.DateTime(3)
  createdBy      User         @relation(fields: [createdById], references: [id])
  items          SaleItem[]

  @@index([createdAt])
  @@index([status])
  @@map("sales")
}

model SaleItem {
  id          String   @id @default(uuid()) @db.Char(36)
  saleId      String   @map("sale_id") @db.Char(36)
  productId   String   @map("product_id") @db.Char(36)
  productName String   @map("product_name") @db.VarChar(160)
  barcode     String   @db.VarChar(64)
  quantity    Int
  unitPrice   Decimal  @map("unit_price") @db.Decimal(12, 2)
  subtotal    Decimal  @db.Decimal(12, 2)
  createdAt   DateTime @default(now()) @map("created_at") @db.DateTime(3)
  sale        Sale     @relation(fields: [saleId], references: [id], onDelete: Restrict)
  product     Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([saleId])
  @@index([productId])
  @@map("sale_items")
}

model StockMovement {
  id            String                 @id @default(uuid()) @db.Char(36)
  productId     String                 @map("product_id") @db.Char(36)
  userId        String                 @map("user_id") @db.Char(36)
  movementType  StockMovementType      @map("movement_type")
  quantityDelta Int                    @map("quantity_delta")
  stockBefore   Int                    @map("stock_before")
  stockAfter    Int                    @map("stock_after")
  referenceType StockReferenceType?    @map("reference_type")
  referenceId   String?                @map("reference_id") @db.Char(36)
  notes         String?                @db.VarChar(500)
  createdAt     DateTime               @default(now()) @map("created_at") @db.DateTime(3)
  product       Product                @relation(fields: [productId], references: [id], onDelete: Restrict)
  user          User                   @relation(fields: [userId], references: [id])

  @@index([productId])
  @@index([createdAt])
  @@index([productId, createdAt])
  @@index([referenceType, referenceId])
  @@map("stock_movements")
}
